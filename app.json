{
  "expo": {
    "name": "만나",
    "slug": "manna",
    "scheme": "manna",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/99aa66ee-0480-4657-b6d1-3fb03ea33008",
      "channel": "production"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jsj.manna",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "ko"
        ],
        "CFBundleDevelopmentRegion": "ko"
      },
      "buildNumber": "36"
    },
    "android": {
      "package": "com.jsj.manna",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0A12"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D4A847",
          "sounds": []
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "99aa66ee-0480-4657-b6d1-3fb03ea33008"
      }
    },
    "owner": "jangsung"
  }
}
